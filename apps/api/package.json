{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "// --- 1. LOCAL DEVELOPMENT ---": "",
    "dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "// --- 2. DATABASE & AUTH (Local Dev) ---": "",
    "prisma:generate": "pnpm dlx prisma generate",
    "prisma:migrate": "pnpm dlx prisma migrate dev",
    "prisma:studio": "pnpm dlx prisma studio",
    "prisma:seed": "pnpm dlx prisma db seed",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth.ts",
    "// --- 3. TESTING (Forces .env.test) ---": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "pretest:e2e": "dotenv -e .env.test -- prisma db push --skip-generate",
    "test:e2e": "dotenv -e .env.test -- vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:watch": "dotenv -e .env.test -- vitest --config ./vitest.config.e2e.ts",
    "// --- 4. PRODUCTION / future CI/CD PIPELINE ---": "",
    "start:prod": "node dist/src/main.js",
    "prod:migrate": "pnpm dlx prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@thallesp/nestjs-better-auth": "^2.5.1",
    "better-auth": "^1.5.5",
    "bullmq": "^5.71.0",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "nestjs-zod": "^5.2.1",
    "pg": "^8.20.0",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@swc/core": "^1.15.18",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
