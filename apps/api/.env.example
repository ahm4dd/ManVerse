# ==========================================
# Production 
# ==========================================

# We are assuming that you are using a secrets manager during CI/CD

# ==========================================
# DEVELOPMENT (.env)
# ==========================================
NODE_ENV='development'

# NestJS API PORT
PORT=3000

# Better-auth Constants
BETTER_AUTH_SECRET='replace-me-with-base64-secret'
BETTER_AUTH_URL='http://localhost:3000' # Base URL of your app. Production must use https.
ANILIST_IDENTITY_SALT='replace-me-with-a-stable-random-string-of-at-least-32-characters' # Required when AniList OAuth is enabled. Keep this stable and distinct from BETTER_AUTH_SECRET.
TRUST_PROXY='false' # Set to true or a positive proxy hop count only when your deployment is behind a trusted reverse proxy.
TRUSTED_ORIGINS='http://localhost:3000,http://localhost:5173' # Comma-separated origins only. Production must use https and include BETTER_AUTH_URL's origin.

# Throttling
THROTTLE_STORAGE='memory' # Use 'redis' only for production deployments that share a Redis-backed rate-limit store.
REDIS_URL='' # Required when NODE_ENV=production and THROTTLE_STORAGE=redis. Use redis:// or rediss://.
REDIS_THROTTLE_KEY_PREFIX='manverse:throttle:'
THROTTLE_GLOBAL_LIMIT='100'
THROTTLE_GLOBAL_TTL_MS='60000'
THROTTLE_BURST_LIMIT='10'
THROTTLE_BURST_TTL_MS='1000'
THROTTLE_AUTHENTICATED_READ_LIMIT='30'
THROTTLE_AUTHENTICATED_READ_TTL_MS='60000'
THROTTLE_SECRET_LIMIT='10'
THROTTLE_SECRET_TTL_MS='60000'
THROTTLE_AUTH_SENSITIVE_LIMIT='5'
THROTTLE_AUTH_SENSITIVE_TTL_MS='60000'

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/manverse-api-development'

# Anilist Integration
ANILIST_OAUTH_ENABLED='false'
ANILIST_CLIENT_ID=''
ANILIST_CLIENT_SECRET=''

# ==========================================
# TESTING (.env.test)
# Copy these values into a .env.test file
# ==========================================
# Same constants, just these changed
# NODE_ENV="test"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/manverse_test"
