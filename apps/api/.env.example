# ==========================================
# Production 
# ==========================================

# We are assuming that you are using a secrets manager during CI/CD

# ==========================================
# DEVELOPMENT (.env)
# ==========================================
NODE_ENV='development'

# NestJS API PORT
PORT=3000

# Better-auth Constants
BETTER_AUTH_SECRET='replace-me-with-base64-secret'
BETTER_AUTH_URL='http://localhost:3000' # Base URL of your app
TRUSTED_ORIGINS='http://localhost:3000,http://localhost:5173'

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/manverse-api-development'

# Anilist Integration
ANILIST_OAUTH_ENABLED='false'
ANILIST_CLIENT_ID=''
ANILIST_CLIENT_SECRET=''

# ==========================================
# TESTING (.env.test)
# Copy these values into a .env.test file
# ==========================================
# Same constants, just these changed
# NODE_ENV="test"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/manverse_test"
