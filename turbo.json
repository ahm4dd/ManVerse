{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "setup": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "test:e2e:watch": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "clean": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "api#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": ["@manverse/anilist-client#dev"]
    },
    "api#test:watch": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": ["@manverse/anilist-client#dev"]
    },
    "api#test:e2e:watch": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": ["@manverse/anilist-client#dev"]
    }
  }
}

